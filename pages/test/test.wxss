.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.progress {
  margin-bottom: 30px;
}

.progress-text {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  display: block;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background-color: #f0f0f0;
  border-radius: 3px;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background-color: #1aad19;
  transition: width 0.3s ease;
}

.question-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.question-text {
  font-size: 18px;
  color: #333;
  margin-bottom: 30px;
  line-height: 1.5;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.option {
  background-color: #f8f8f8;
  padding: 15px;
  border-radius: 8px;
  transition: all 0.3s ease;
  border: 1px solid transparent;
}

.option.selected {
  background-color: #e8f5e9;
  border: 1px solid #1aad19;
}

.option-text {
  font-size: 16px;
  color: #333;
}

.navigation {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
}

.nav-button {
  flex: 1;
  margin: 0 10px;
  border-radius: 30px;
}

.nav-button.prev {
  background-color: #f8f8f8;
  color: #333;
}

.nav-button.next {
  background-color: #1aad19;
  color: white;
}

.nav-button.submit {
  background-color: #1aad19;
  color: white;
  width: 100%;
} 