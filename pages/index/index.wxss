/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}

.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40px;
}

.logo {
  width: 120px;
  height: 120px;
  margin-bottom: 20px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
}

.intro {
  background-color: #f8f8f8;
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 30px;
  width: 100%;
}

.intro-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
  display: block;
}

.intro-content {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.features {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 40px;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 40px;
  height: 40px;
  margin-bottom: 8px;
}

.feature-text {
  font-size: 14px;
  color: #666;
}

.start-button {
  background-color: #1aad19;
  color: white;
  width: 80%;
  border-radius: 30px;
  font-size: 16px;
  margin-top: 20px;
}

.counter-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 50px;
}

.counter-title {
  font-size: 18px;
  color: #333;
  margin-bottom: 10px;
}

.counter-number {
  font-size: 36px;
  font-weight: bold;
  color: #1aad19;
  margin: 20px 0;
}

.counter-button {
  background-color: #1aad19;
  color: white;
  margin: 10px 0;
  width: 200px;
}

.reset-button {
  background-color: #f8f8f8;
  color: #333;
  margin: 10px 0;
  width: 200px;
}

.log-link {
  margin-top: 30px;
}

.log-button {
  color: #1aad19;
  text-decoration: underline;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20px;
  background-color: #f8f8f8;
  border-radius: 10px;
  margin-bottom: 20px;
}

.avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin-right: 15px;
}

.nickname {
  font-size: 16px;
  color: #333;
}
