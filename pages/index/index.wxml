<!--index.wxml-->
<view class="container">
  <view class="user-info" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <text class="nickname">{{userInfo.nickName}}</text>
  </view>

  <view class="header">
    <image class="logo" src="/images/mbti-logo.png" mode="aspectFit"></image>
    <text class="title">MBTI性格测试</text>
  </view>
  
  <view class="intro">
    <text class="intro-title">什么是MBTI？</text>
    <text class="intro-content">MBTI（迈尔斯-布里格斯性格类型指标）是一种人格类型理论模型，它将人的性格分为16种类型。通过这个测试，你可以更好地了解自己的性格特点、优势和潜在的发展方向。</text>
  </view>

  <view class="features">
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon1.png" mode="aspectFit"></image>
      <text class="feature-text">专业测试</text>
    </view>
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon2.png" mode="aspectFit"></image>
      <text class="feature-text">详细分析</text>
    </view>
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon3.png" mode="aspectFit"></image>
      <text class="feature-text">性格解读</text>
    </view>
  </view>

  <button class="start-button" bindtap="startTest">开始测试</button>
</view>
